# App
APP_ENV=local
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=careervector
POSTGRES_USER=careervector
POSTGRES_PASSWORD=careervector
DATABASE_URL=postgresql+asyncpg://careervector:careervector@localhost:5432/careervector

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_VACANCIES=vacancies
QDRANT_COLLECTION_CANDIDATES=candidates

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Provider (Anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_DEFAULT_MODEL=claude-sonnet-5

# Embeddings
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Rate limiting
RATE_LIMIT_DEFAULT=100/minute
